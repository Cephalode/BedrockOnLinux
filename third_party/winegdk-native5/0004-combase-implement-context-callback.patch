     {
@@ -2731,14 +2842,31 @@ HRESULT WINAPI CoGetContextToken(ULONG_PTR *token)
 
         context = calloc(1, sizeof(*context));
         if (!context)
+        {
+            apartment_release(apt);
             return E_OUTOFMEMORY;
