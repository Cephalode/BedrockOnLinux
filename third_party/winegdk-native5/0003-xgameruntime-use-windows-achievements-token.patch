                    context->method, rp, (unsigned long long)context->count,
@@ -1116,7 +1196,70 @@ static HRESULT CALLBACK XUserGetTokenAndSignatureProvider( XAsyncOp operation, c
             token_uhs = user_impl->local_id.value;
