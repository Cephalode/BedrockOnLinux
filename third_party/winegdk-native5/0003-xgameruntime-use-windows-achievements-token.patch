@@ -324,6 +375,26 @@ static HRESULT LoadDefaultUser( XUserHandle *user, LPCSTR client_id )
                             if (uhs_s && SUCCEEDED( HSTRINGToMultiByte( uhs_s, &mb, &ml ) ) && mb)
