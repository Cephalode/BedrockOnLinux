+    if (InterlockedCompareExchange(&operation->closed, 0, 0)) return E_ILLEGAL_METHOD_CALL;
+    if (FAILED(operation->error)) return operation->error;
+    IStorageFile_AddRef(*result = operation->result);
+    return S_OK;
+}
