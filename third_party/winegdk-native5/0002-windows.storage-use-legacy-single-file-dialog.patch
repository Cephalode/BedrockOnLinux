 dlls/windows.storage.applicationdata/main.c   |   2 +
 .../windows.storage.applicationdata/private.h |   1 +
 .../storagefile.c                             | 847 ++++++++++++++++++
 dlls/windows.storage/Makefile.in              |   2 +-
